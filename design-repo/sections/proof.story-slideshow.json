{
  "id": "proof.story-slideshow",
  "category": "proof",
  "version": "1.0.0",
  "purpose": "Testimonial slideshow of photo + tinted quote-panel cards with a pager pill.",
  "evidenceLevel": "measured",
  "variants": {
    "wide": "956x393 cards, pink or peach tint, 'See customer story' pill; one static card below 1200px.",
    "split": "456px image + panel per slide, per-slide tint.",
    "testimonial": "Same card as split with a sub line."
  },
  "composes": [
    "component.story-slideshow"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 9
      },
      "sub": {
        "type": "string",
        "maxWords": 10
      },
      "tint": {
        "enum": [
          "peach",
          "pink"
        ]
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "quote": {
              "type": "string",
              "maxWords": 28
            },
            "name": {
              "type": "string",
              "maxWords": 3
            },
            "role": {
              "type": "string",
              "maxWords": 6
            },
            "photo": {
              "type": "object",
              "properties": {
                "assetRole": {
                  "const": "photo.stock-person"
                },
                "src": {
                  "enum": [
                    "/assets/photos/compare-avatar-1.webp",
                    "/assets/photos/compare-avatar-2.webp",
                    "/assets/photos/compare-avatar-3.webp",
                    "/assets/photos/hero-bl.webp",
                    "/assets/photos/hero-br.webp",
                    "/assets/photos/hero-center.webp",
                    "/assets/photos/hero-tl.webp",
                    "/assets/photos/hero-tr.webp",
                    "/assets/photos/nav-feature-industries.webp",
                    "/assets/photos/nav-feature-product.webp",
                    "/assets/photos/playbook-avatar-c.webp",
                    "/assets/photos/playbook-avatar-p2l.webp",
                    "/assets/photos/playbook-avatar-p2r.webp",
                    "/assets/photos/playbook-avatar-p4l.webp",
                    "/assets/photos/playbook-avatar-p4r.webp",
                    "/assets/photos/playbook-avatar-p6l.webp",
                    "/assets/photos/playbook-avatar-p6r.webp",
                    "/assets/photos/proof-portrait-1.webp",
                    "/assets/photos/proof-portrait-2.webp",
                    "/assets/photos/story-1.webp",
                    "/assets/photos/story-2.webp",
                    "/assets/photos/story-3.webp",
                    "/assets/photos/story-4.webp",
                    "/assets/photos/story-5.webp",
                    "/assets/photos/story-6.webp",
                    "/assets/photos/video-teaser-thumb.webp"
                  ]
                }
              },
              "required": [
                "assetRole",
                "src"
              ],
              "additionalProperties": false
            },
            "tint": {
              "enum": [
                "green",
                "peach",
                "pink"
              ]
            },
            "logo": {
              "type": "object",
              "properties": {
                "assetRole": {
                  "const": "logo.placeholder"
                },
                "name": {
                  "type": "string",
                  "maxWords": 3
                },
                "shape": {
                  "enum": [
                    "arc",
                    "bars",
                    "circle",
                    "diamond",
                    "plus",
                    "ring",
                    "square",
                    "triangle"
                  ]
                }
              },
              "required": [
                "assetRole",
                "name",
                "shape"
              ],
              "additionalProperties": false
            },
            "href": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._~/?#=&%-]*|#[A-Za-z0-9_-]*)$",
              "description": "Internal path or in-page anchor only. External URLs are not allowed: the build makes no outbound links or requests."
            }
          },
          "required": [
            "quote",
            "name",
            "role",
            "photo"
          ],
          "additionalProperties": false
        },
        "minItems": 2,
        "maxItems": 3
      }
    },
    "required": [
      "title",
      "items"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "slideshow-autoplay",
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "swap-variant",
      "detail": "wide: one static card below 1200px; split/testimonial: 315px column cards."
    }
  ],
  "constraints": {
    "maxPerPage": 1
  },
  "measuredFrom": [
    "src.stories",
    "mo.slide"
  ],
  "variantRules": {
    "wide": {
      "requires": [
        "tint"
      ],
      "forbids": [
        "sub"
      ]
    },
    "testimonial": {
      "requires": [
        "sub"
      ]
    },
    "split": {
      "forbids": [
        "sub",
        "tint"
      ]
    }
  }
}
