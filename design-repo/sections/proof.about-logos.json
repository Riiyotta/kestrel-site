{
  "id": "proof.about-logos",
  "category": "proof",
  "version": "1.0.0",
  "purpose": "About-page trust block: heading over one bordered single-row logo strip on a white-to-grey fade.",
  "evidenceLevel": "measured",
  "variants": {
    "logos": "Heading + single strip, no reveal."
  },
  "composes": [
    "component.logo-marquee"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "heading": {
        "type": "string",
        "maxWords": 16
      },
      "logos": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assetRole": {
              "const": "logo.placeholder"
            },
            "name": {
              "type": "string",
              "maxWords": 3
            },
            "shape": {
              "enum": [
                "arc",
                "bars",
                "circle",
                "diamond",
                "plus",
                "ring",
                "square",
                "triangle"
              ]
            }
          },
          "required": [
            "assetRole",
            "name",
            "shape"
          ],
          "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 7
      }
    },
    "required": [
      "heading",
      "logos"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "marquee",
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "resize",
      "detail": "Strip narrows to 326px; still single row."
    }
  ],
  "constraints": {
    "onePerPage": true
  },
  "measuredFrom": [
    "src.proof-logos"
  ]
}
