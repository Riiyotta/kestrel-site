{
  "id": "hero.doc-header",
  "category": "hero",
  "version": "1.0.0",
  "purpose": "Small document header: H1, grey lede, last-updated line.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Left-aligned."
  },
  "composes": [],
  "contentModel": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
