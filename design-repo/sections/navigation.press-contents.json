{
  "id": "navigation.press-contents",
  "category": "navigation",
  "version": "1.0.0",
  "purpose": "Press-kit contents row: heading and three anchor links.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Two-column row."
  },
  "composes": [],
  "contentModel": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 3
      },
      "links": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 3
            },
            "href": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._~/?#=&%-]*|#[A-Za-z0-9_-]*)$",
              "description": "Internal path or in-page anchor only. External URLs are not allowed: the build makes no outbound links or requests."
            }
          },
          "required": [
            "label",
            "href"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 3
      }
    },
    "required": [
      "title",
      "links"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "resize",
      "detail": "Smaller type."
    }
  ],
  "constraints": {
    "onePerPage": true
  },
  "measuredFrom": [
    "src.presskit"
  ]
}
