{
  "id": "chrome.jobs-footer",
  "category": "chrome",
  "version": "1.0.0",
  "purpose": "Jobs microsite link-column footer.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Three link columns + legal row."
  },
  "composes": [],
  "contentModel": {
    "type": "object",
    "properties": {
      "columns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxWords": 3
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string",
                "maxWords": 4
              },
              "minItems": 1,
              "maxItems": 4
            }
          },
          "required": [
            "title",
            "links"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 3
      }
    },
    "required": [
      "columns"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "stack",
      "detail": "Columns stack on phone."
    }
  ],
  "constraints": {
    "onePerPage": true,
    "mustBeLast": true
  },
  "measuredFrom": [
    "src.jobsfooter"
  ]
}
