{
  "id": "compare.vs-feature-cards",
  "category": "compare",
  "version": "1.0.0",
  "purpose": "Row of three grey feature cards with an indigo icon tile under the matrix.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Three cards."
  },
  "composes": [
    "primitive.icon-glyph"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "icon": {
              "type": "object",
              "properties": {
                "assetRole": {
                  "const": "icon.glyph"
                },
                "name": {
                  "enum": [
                    "bolt",
                    "bubble",
                    "channels",
                    "check",
                    "code",
                    "coin",
                    "cross",
                    "dot",
                    "ear",
                    "globe",
                    "headset",
                    "heart",
                    "inbox",
                    "key",
                    "keypad",
                    "layers",
                    "pen",
                    "people",
                    "shield",
                    "stack",
                    "target",
                    "tree",
                    "wrench"
                  ]
                }
              },
              "required": [
                "assetRole",
                "name"
              ],
              "additionalProperties": false
            },
            "title": {
              "type": "string",
              "maxWords": 6
            },
            "body": {
              "type": "string",
              "maxWords": 59
            }
          },
          "required": [
            "icon",
            "title",
            "body"
          ],
          "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 3
      }
    },
    "required": [
      "items"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "stack",
      "detail": "Cards stack."
    }
  ],
  "constraints": {
    "onePerPage": true,
    "mustFollow": "compare.matrix"
  },
  "measuredFrom": [
    "src.vsfeat"
  ]
}
