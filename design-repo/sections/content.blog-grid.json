{
  "id": "content.blog-grid",
  "category": "content",
  "version": "1.0.0",
  "purpose": "Top-ruled H2, three journal cards and a centred view-all button.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Three cards."
  },
  "composes": [
    "component.blog-card"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 5
      },
      "posts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxWords": 17
            },
            "href": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._~/?#=&%-]*|#[A-Za-z0-9_-]*)$",
              "description": "Internal path or in-page anchor only. External URLs are not allowed: the build makes no outbound links or requests."
            }
          },
          "required": [
            "title",
            "href"
          ],
          "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 3
      },
      "cta": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxWords": 5
          },
          "href": {
            "type": "string",
            "pattern": "^(/[A-Za-z0-9._~/?#=&%-]*|#[A-Za-z0-9_-]*)$",
            "description": "Internal path or in-page anchor only. External URLs are not allowed: the build makes no outbound links or requests."
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "title",
      "posts",
      "cta"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "stack",
      "detail": "Cards stack."
    }
  ],
  "constraints": {
    "onePerPage": true
  },
  "measuredFrom": [
    "src.prodsections"
  ]
}
