{
  "id": "content.blog-browse",
  "category": "content",
  "version": "1.0.0",
  "purpose": "'Browse all': ring filter tabs synced to the URL, then a three-column card grid.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Tabs + grid."
  },
  "composes": [
    "component.filter-chips",
    "component.blog-card"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 3
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string",
          "maxWords": 3
        },
        "minItems": 2,
        "maxItems": 6
      },
      "posts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxWords": 17
            },
            "date": {
              "type": "string",
              "maxWords": 3
            },
            "cover": {
              "type": "object",
              "properties": {
                "tone": {
                  "enum": [
                    "indigo",
                    "lavender",
                    "magenta",
                    "mint",
                    "peach",
                    "sun"
                  ]
                }
              },
              "required": [
                "tone"
              ],
              "additionalProperties": false
            },
            "href": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._~/?#=&%-]*|#[A-Za-z0-9_-]*)$",
              "description": "Internal path or in-page anchor only. External URLs are not allowed: the build makes no outbound links or requests."
            }
          },
          "required": [
            "title",
            "date",
            "cover",
            "href"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 8
      }
    },
    "required": [
      "title",
      "categories",
      "posts"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "filter-chips",
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "md",
      "change": "grid-collapse",
      "detail": "Two columns."
    },
    {
      "breakpoint": "base",
      "change": "stack",
      "detail": "One column."
    }
  ],
  "constraints": {
    "onePerPage": true
  },
  "measuredFrom": [
    "src.blogindex"
  ]
}
