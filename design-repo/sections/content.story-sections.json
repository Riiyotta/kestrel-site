{
  "id": "content.story-sections",
  "category": "content",
  "version": "1.0.0",
  "purpose": "Story body chapters: heading, paragraphs and a per-chapter media slot (photo, quote, stat table or integration illustration).",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Up to five chapters."
  },
  "composes": [],
  "contentModel": {
    "type": "object",
    "properties": {
      "theme": {
        "enum": [
          "green",
          "neutral",
          "pink",
          "red",
          "yellow"
        ]
      },
      "facts": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "maxWords": 3
          },
          "industry": {
            "type": "string",
            "maxWords": 3
          },
          "size": {
            "type": "string",
            "maxWords": 3
          }
        },
        "required": [
          "company",
          "industry",
          "size"
        ],
        "additionalProperties": false
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "navLabel": {
              "type": "string",
              "maxWords": 3
            },
            "heading": {
              "type": "string",
              "maxWords": 3
            },
            "body": {
              "type": "array",
              "items": {
                "type": "string",
                "maxWords": 74
              },
              "minItems": 0,
              "maxItems": 2
            },
            "media": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "image"
                    },
                    "photo": {
                      "type": "object",
                      "properties": {
                        "assetRole": {
                          "const": "photo.stock-person"
                        },
                        "src": {
                          "enum": [
                            "/assets/photos/compare-avatar-1.webp",
                            "/assets/photos/compare-avatar-2.webp",
                            "/assets/photos/compare-avatar-3.webp",
                            "/assets/photos/hero-bl.webp",
                            "/assets/photos/hero-br.webp",
                            "/assets/photos/hero-center.webp",
                            "/assets/photos/hero-tl.webp",
                            "/assets/photos/hero-tr.webp",
                            "/assets/photos/nav-feature-industries.webp",
                            "/assets/photos/nav-feature-product.webp",
                            "/assets/photos/playbook-avatar-c.webp",
                            "/assets/photos/playbook-avatar-p2l.webp",
                            "/assets/photos/playbook-avatar-p2r.webp",
                            "/assets/photos/playbook-avatar-p4l.webp",
                            "/assets/photos/playbook-avatar-p4r.webp",
                            "/assets/photos/playbook-avatar-p6l.webp",
                            "/assets/photos/playbook-avatar-p6r.webp",
                            "/assets/photos/proof-portrait-1.webp",
                            "/assets/photos/proof-portrait-2.webp",
                            "/assets/photos/story-1.webp",
                            "/assets/photos/story-2.webp",
                            "/assets/photos/story-3.webp",
                            "/assets/photos/story-4.webp",
                            "/assets/photos/story-5.webp",
                            "/assets/photos/story-6.webp",
                            "/assets/photos/video-teaser-thumb.webp"
                          ]
                        },
                        "alt": {
                          "type": "string",
                          "maxWords": 11
                        }
                      },
                      "required": [
                        "assetRole",
                        "src",
                        "alt"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "photo"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "quote"
                    },
                    "text": {
                      "type": "string",
                      "maxWords": 38
                    },
                    "name": {
                      "type": "string",
                      "maxWords": 3
                    },
                    "role": {
                      "type": "string",
                      "maxWords": 6
                    }
                  },
                  "required": [
                    "type",
                    "text",
                    "name",
                    "role"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "imageStat"
                    },
                    "text": {
                      "type": "string",
                      "maxWords": 9
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxWords": 5
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "minItems": 2,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "type",
                    "text",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "illustration"
                    },
                    "left": {
                      "type": "object",
                      "properties": {
                        "assetRole": {
                          "const": "logo.placeholder"
                        },
                        "name": {
                          "type": "string",
                          "maxWords": 3
                        },
                        "shape": {
                          "enum": [
                            "arc",
                            "bars",
                            "circle",
                            "diamond",
                            "plus",
                            "ring",
                            "square",
                            "triangle"
                          ]
                        }
                      },
                      "required": [
                        "assetRole",
                        "name",
                        "shape"
                      ],
                      "additionalProperties": false
                    },
                    "right": {
                      "type": "object",
                      "properties": {
                        "assetRole": {
                          "const": "logo.placeholder"
                        },
                        "name": {
                          "type": "string",
                          "maxWords": 3
                        },
                        "shape": {
                          "enum": [
                            "arc",
                            "bars",
                            "circle",
                            "diamond",
                            "plus",
                            "ring",
                            "square",
                            "triangle"
                          ]
                        }
                      },
                      "required": [
                        "assetRole",
                        "name",
                        "shape"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "left",
                    "right"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "id",
            "heading"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 3
      }
    },
    "required": [
      "theme",
      "facts",
      "sections"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedProfiles": [
      "none"
    ],
    "reducedMotionFallbackRequired": true
  },
  "responsive": [
    {
      "breakpoint": "base",
      "change": "resize",
      "detail": "843px column narrows to full width."
    }
  ],
  "constraints": {
    "onePerPage": true
  },
  "measuredFrom": [
    "src.storysection"
  ]
}
