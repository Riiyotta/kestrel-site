    {
      "id": "faq",
      "type": "content.faq-accordion",
      "variant": "hairline",
      "content": {
        "items": [
          {
            "q": "Should every escalation go to a senior agent?",
            "a": "No. Route by the skill the case needs; seniority is only one of several signals."
          },
          {
            "q": "How long should a summary be?",
            "a": "Two or three short lines. If it needs more, the playbook step that stopped is usually unclear."
          }
        ]
      },
