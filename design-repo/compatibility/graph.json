{
  "$description": "Rhythm and position rules a JSON Schema cannot express. Every rule id here is implemented in schema/semantic_validate.py (verify_all.py asserts the two sets are identical). recommendedAfter is derived from the real template node sequences.",
  "rules": [
    {
      "id": "TEMPLATE_NODES",
      "severity": "error",
      "rule": "Every node must be in the declared template's node list (matched on section + variant), within its repeat limits, and every required template node must be present."
    },
    {
      "id": "TEMPLATE_ORDER",
      "severity": "error",
      "rule": "Nodes must follow the declared template's node order."
    },
    {
      "id": "ROUTE",
      "severity": "error",
      "rule": "The route must be one the declared template serves (not-found: any path that no other template serves)."
    },
    {
      "id": "CHROME_FIRST",
      "severity": "error",
      "rule": "Site-layout pages start with chrome.nav; standalone pages start with their own chrome (jobs header, doc sidebar) or, for get-a-demo, the form."
    },
    {
      "id": "FOOTER_POSITION",
      "severity": "error",
      "rule": "On site-layout pages chrome.footer is the last node, optionally followed only by chrome.video-teaser."
    },
    {
      "id": "TEASER_MATCHES_ROUTE",
      "severity": "error",
      "rule": "chrome.video-teaser is present on site-layout routes except those matching routing.noTeaserPatterns, and absent there."
    },
    {
      "id": "ONE_HERO",
      "severity": "error",
      "rule": "Exactly one hero.* node, except the named hero-less templates in routing.heroLessTemplates, which must have none."
    },
    {
      "id": "HERO_AFTER_CHROME",
      "severity": "error",
      "rule": "The hero directly follows the leading chrome node (index 1)."
    },
    {
      "id": "ONE_PER_PAGE",
      "severity": "error",
      "rule": "Sections with constraints.onePerPage appear at most once."
    },
    {
      "id": "MAX_PER_PAGE",
      "severity": "error",
      "rule": "Sections with constraints.maxPerPage stay within it; a repeated section must use distinct variants (keyed on section + variant)."
    },
    {
      "id": "NO_ADJACENT_SAME_SECTION",
      "severity": "warn",
      "rule": "The same section type should not sit twice in a row. Named exception: none needed by any real template; split-text and toc repeat non-adjacently."
    },
    {
      "id": "HOME_ROUTE_ONLY",
      "severity": "error",
      "rule": "Sections with constraints.homeRouteOnly only appear on '/'."
    },
    {
      "id": "MUST_FOLLOW",
      "severity": "error",
      "rule": "compare.vs-feature-cards must directly follow compare.matrix."
    },
    {
      "id": "ROUTE_VARIANT",
      "severity": "error",
      "rule": "Where a template pins a section variant per route (routeVariants), the node must use that variant."
    },
    {
      "id": "ROUTE_NODE_RULES",
      "severity": "error",
      "rule": "Optional nodes listed in routeNodeRules are present exactly on the listed routes."
    },
    {
      "id": "VARIANT_RULES",
      "severity": "error",
      "rule": "Variant-specific required/forbidden content fields (section variantRules) hold."
    },
    {
      "id": "FORMS_LOCAL_ONLY",
      "severity": "error",
      "rule": "Every form's submission is 'local-success-state': nothing is ever sent."
    },
    {
      "id": "NO_EXTERNAL_URLS",
      "severity": "error",
      "rule": "No content string may contain an http(s) URL; links are internal paths or anchors only."
    },
    {
      "id": "INLINE_HTML_SUBSET",
      "severity": "error",
      "rule": "Inline HTML in copy uses only <a href>, <strong>, <em>, <br>, and links point at internal paths."
    },
    {
      "id": "LINK_TARGETS",
      "severity": "warn",
      "rule": "Internal links should resolve to a known route. Named exception: /glossary/<slug> intentionally renders the 404 page."
    },
    {
      "id": "MAX_WORDS",
      "severity": "error",
      "rule": "Every text field respects its contract's maxWords budget."
    },
    {
      "id": "MOTION_FALLBACK",
      "severity": "error",
      "rule": "Every node names a motion profile allowed by its section and the profile's const-locked reducedMotionFallback."
    },
    {
      "id": "ASSET_ROLE_POLICY",
      "severity": "error",
      "rule": "Media objects use only pageSpecSettable roles from assets/asset-roles.json; pinned policies are intact."
    },
    {
      "id": "UNIQUE_IDS",
      "severity": "error",
      "rule": "Node ids are unique within the page."
    }
  ],
